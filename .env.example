# W2HMS vNext — environment template
# Copy to `.env.local` for local development. `.env.local` is git-ignored.
# NEVER put secrets, private keys or service-account credentials in any VITE_* variable:
# every VITE_* value is embedded in the public JavaScript bundle.

# development | production
VITE_APP_ENV=development

# GitHub Pages project-site base path (must start and end with "/")
VITE_BASE_PATH=/W2HMS-vNext/

# --- Firebase (Phase 1: emulator only) ---------------------------------------
# "demo-" project IDs are offline-only: the Firebase SDK and Emulator Suite
# never contact real Firebase services for them. Keep this in Phase 1.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-w2hms
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Web app config for a real project — leave EMPTY in Phase 1.
# (These are public identifiers, not secrets, but connecting a real project
# is not approved yet.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
